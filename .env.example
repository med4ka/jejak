# Salin jadi .env lalu sesuaikan. Kode memuat .env otomatis saat start.
# Jangan commit file .env (berisi password lokal).

# ---------- Backend Go (api, worker, proxy) ----------

# baseline = 1 instance, 1 DB, tanpa cache/queue (mirip Fase 0)
# full     = primary + replica + cache + queue async
# shard    = sharded store ala Fase 5 (butuh SHARD_DSNS)
APP_MODE=full

# Port HTTP API. Jalankan 2 instance dengan PORT beda (mis. 8081 dan 8082)
# agar load balancer punya 2 backend. Proxy LB juga membaca PORT (default 8090).
PORT=8080

# PostgreSQL native lokal (default cocok untuk install standar di Windows).
# Dipakai juga oleh worker (di sana WAJIB diisi).
DATABASE_URL=postgres://jejak:password@localhost:5432/jejak?sslmode=disable

# Simulasi read replica Fase 4: database KEDUA di server yang sama.
# Kosongkan (= tanpa replica, baca fallback ke primary).
DATABASE_REPLICA_URL=postgres://jejak:password@localhost:5432/jejak_replica?sslmode=disable

# Redis lokal (redis://) atau Upstash (rediss://... dengan password di URL).
# Kosongkan (= tanpa cache/queue, click logging jadi sinkron).
REDIS_URL=redis://localhost:6379

# Daftar backend untuk load balancer round-robin (binary proxy), comma-separated.
BACKENDS=http://localhost:8081,http://localhost:8082

# Hanya untuk APP_MODE=shard, comma-separated, satu DSN per shard.
# SHARD_DSNS=postgres://jejak:password@localhost:5432/jejak,postgres://jejak:password@localhost:5433/jejak

# ---------- Frontend (Next.js) ----------
# Variabel ini dibaca oleh app Next; set lewat OS environment saat menjalankan
# `npm run dev` / `npm run build`, atau frontend/.env jika dibutuhkan.

# Origin API Go yang di-proxy route handler Next (semua /api/* dan /uploads).
GO_API_URL=http://localhost:8081

# Origin publik situs — dipakai metadata/SEO (metadataBase di root layout).
SITE_URL=http://localhost:3000

# Origin API untuk panggilan langsung dari browser (dashboard client-side).
NEXT_PUBLIC_API_URL=http://localhost:8081